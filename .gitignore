# Dependencies (none required at runtime, but this keeps installs out of git)
node_modules/
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# Runtime state that should not be committed
blend-battles/data/db.json.tmp
blend-battles/data/uploads/tmp-*

# Runtime uploads — keep only the seeded demo proof images in git
blend-battles/data/uploads/*
!blend-battles/data/uploads/seed-proof-*.svg
